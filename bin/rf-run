#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "$SCRIPT_DIR"

# 1. Check for AWS mode in environment or .env (default: local)
AWS_MODE=0
BACKEND_VAL="${RF_BACKEND:-}"
if [ -z "$BACKEND_VAL" ]; then
    if [ -f "${REPO_ROOT}/.env" ]; then
        BACKEND_VAL=$(grep -E "^RF_BACKEND=" "${REPO_ROOT}/.env" | head -n 1 | cut -d '=' -f 2 | tr -d '\r"')
    fi
    if [ -z "$BACKEND_VAL" ] && [ -f "${SCRIPT_DIR}/.env" ]; then
        BACKEND_VAL=$(grep -E "^RF_BACKEND=" "${SCRIPT_DIR}/.env" | head -n 1 | cut -d '=' -f 2 | tr -d '\r"')
    fi
fi
SAAS_MODE=0
if [ "$BACKEND_VAL" = "aws_saas" ] || [ "$BACKEND_VAL" = "saas" ] || [ "$BACKEND_VAL" = "aws" ]; then
    SAAS_MODE=1
fi

if [ "$SAAS_MODE" -eq 1 ]; then
    echo "[RF Suite] SaaS Microservice Backend Active ($BACKEND_VAL)..."
    cd "$REPO_ROOT"
    if command -v python3 >/dev/null 2>&1; then
        exec python3 -m agent.workflow --backend aws_saas "$@"
    elif command -v python >/dev/null 2>&1; then
        exec python -m agent.workflow --backend aws_saas "$@"
    else
        echo "[RF Suite] Error: python3 is required for SaaS client execution." >&2
        exit 1
    fi
fi

# 2. Local Docker Execution Mode
if docker compose exec rf-suite "$@" 2>/dev/null; then
    exit 0
else
    docker compose run --rm rf-suite "$@"
fi
